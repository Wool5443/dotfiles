[Unit]
Description=Local Ollama models for AFFiNE
[Service]
ExecStart=/home/twenty/Documents/Codex/affine-local-ai/bin/ollama serve
Environment=OLLAMA_HOST=127.0.0.1:11434
Environment=OLLAMA_MODELS=/home/twenty/Documents/Codex/affine-local-ai/models
Environment=OLLAMA_CONTEXT_LENGTH=4096
Environment=OLLAMA_NUM_PARALLEL=1
Environment=OLLAMA_MAX_LOADED_MODELS=1
Environment=OLLAMA_MAX_QUEUE=8
Environment=OLLAMA_KEEP_ALIVE=2m
Environment=OLLAMA_NO_CLOUD=1
Environment=CUDA_VISIBLE_DEVICES=-1
Environment=ROCR_VISIBLE_DEVICES=-1
Environment=GGML_VK_VISIBLE_DEVICES=-1
Environment=OLLAMA_VULKAN=0
Restart=on-failure
RestartSec=5
[Install]
WantedBy=default.target
